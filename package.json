{
  "name": "craftmeetcode",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "contract:compile": "hardhat compile",
    "contract:test": "hardhat test",
    "contract:deploy:bnb:mainnet": "hardhat run scripts/deploy.ts --network bnbMainnet"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.1.0",
    "dotenv": "16.4.7",
    "ethers": "6.14.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "hardhat": "2.28.0",
    "typescript": "5.7.2",
    "vite": "6.0.5"
  }
}
