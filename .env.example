# Salin ke .env. Proyek ini hanya menargetkan BSC Mainnet.
VITE_CHAIN_NAME=BSC Mainnet
VITE_CHAIN_ID=56
VITE_RPC_URL=https://bsc-dataseed.bnbchain.org
VITE_CONTRACT_ADDRESS=
VITE_EXPLORER_URL=https://bscscan.com

# Deploy-only. Ganti RPC jika punya provider tepercaya; jangan log atau bagikan credential-nya.
BNB_MAINNET_RPC_URL=https://bsc-dataseed.bnbchain.org
TREASURY_WALLET=
DEPLOYER_PRIVATE_KEY=

# Diperlukan untuk menjalankan deploy Mainnet setelah pemeriksaan final.
CONFIRM_MAINNET_DEPLOY=
